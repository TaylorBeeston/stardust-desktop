#!/usr/bin/env bash
# Recenter the curved host-mirror panels (WayVR layout) on where you're looking now.
# Look straight ahead, keep still ~0.3 s, then run this. Capture is not torn down:
# every curved Flatland polls $XDG_RUNTIME_DIR/flatland-curve/recenter.req (200 ms); the first
# to see it samples the HMD until still (<2° / <2 cm over 250 ms, max 2 s), writes `anchor`,
# and all panels re-place from that one pose (yaw/radius per panel from panels.conf).
# Usage: stardust-dual-mirror-recenter [--delay SECONDS]   (delay: time to put the headset/keyboard down)
# Nudge the whole set (no new head sample, keeps current anchor; persists in $D/adjust until --reset):
#   stardust-dual-mirror-recenter --yaw +10      rotate both panels 10 deg right (- = left), relative
#   stardust-dual-mirror-recenter --height -0.1  move both 10 cm down (+ = up), relative
#   stardust-dual-mirror-recenter --radius 0.9   distance 0.9 m (absolute; --radius +0.1 = relative)
#   stardust-dual-mirror-recenter --show | --reset
set -euo pipefail
RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; D="$RUN/flatland-curve"; LOG="$RUN/stardust-panel-shell.log"
delay=0; adj=0; reset=0; dy=0; dh=0; rad=""
while [ $# -gt 0 ]; do case "$1" in
  --delay) delay="$2"; shift ;;
  --yaw) dy="$2"; adj=1; shift ;;
  --height) dh="$2"; adj=1; shift ;;
  --radius) rad="$2"; adj=1; shift ;;
  --reset) reset=1; adj=1 ;;
  --show) cat "$D/adjust" 2>/dev/null || echo "(no adjust: yaw 0, height 0, radius 0.70)"; exit 0 ;;
  -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
  *) echo "unknown arg $1" >&2; exit 2 ;;
esac; shift; done
if [ "$adj" = 1 ]; then
  mkdir -p "$D"
  if [ "$reset" = 1 ]; then rm -f "$D/adjust"; echo "adjust reset"; else
  python3 - "$D/adjust" "$dy" "$dh" "$rad" <<'PY'
import sys,os
p,dy,dh,rad=sys.argv[1],float(sys.argv[2]),float(sys.argv[3]),sys.argv[4]
a={"yaw_deg":0.0,"height_m":0.0,"radius_m":0.0}
try:
    for l in open(p):
        k,v=l.split()[:2]; a[k]=float(v)
except (OSError,ValueError): pass
a["yaw_deg"]=max(-180,min(180,a["yaw_deg"]+dy)); a["height_m"]=max(-1.5,min(1.5,a["height_m"]+dh))
if rad:
    base=a["radius_m"] or 0.70
    r=base+float(rad) if rad[0] in "+-" else float(rad)
    a["radius_m"]=max(0.5,min(5.0,r))
a["dragging"]=0.0  # CLI set = discrete: Flatland bakes the mesh at once
tmp=p+".tmp"; open(tmp,"w").write("".join(f"{k} {v:.3f}\n" for k,v in a.items())); os.replace(tmp,p)
print(" ".join(f"{k}={v:.3f}" for k,v in a.items()))
PY
  fi
  exit 0
fi
n=0; for fp in $(pgrep -x flatland); do tr '\0' '\n' </proc/$fp/environ 2>/dev/null | grep -q "^FLATLAND_CURVE_" && n=$((n+1)); done 2>/dev/null
[ "$n" -gt 0 ] || { echo "no curved Flatland panels running (stardust-dual-mirror-flat first)" >&2; exit 1; }
sleep "$delay"
mkdir -p "$D"; L=$(wc -l <"$LOG" 2>/dev/null || echo 0)
touch "$D/recenter.req"
for _ in $(seq 1 30); do
  sleep 0.2
  got=$(tail -n +$((L+1)) "$LOG" 2>/dev/null | grep -c 'placed curved panel' || true)
  [ "$got" -ge "$n" ] && break
done
tail -n +$((L+1)) "$LOG" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E 'head sample|placed curved|recenter failed' | sed 's/.*INFO //' | cut -c1-160
echo "recentered $got/$n panels"
