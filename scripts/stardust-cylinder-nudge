#!/usr/bin/env bash
# Debug: send GroupGrab / SetRadius / Reanchor to the side layout daemon.
# Visual bead is NOT implemented yet (STATUS gap 3); this is how to verify
# group motion over IPC while panels are live.
set -euo pipefail
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/cylinder-headset-side"
SOCK="${CYLINDER_LAYOUT_SOCK:-}"
if [[ -z "$SOCK" && -f "$STATE/layout.sock.path" ]]; then
  SOCK=$(cat "$STATE/layout.sock.path")
fi
SOCK="${SOCK:-${XDG_RUNTIME_DIR:-/run/user/$UID}/stardust-cylinder/layout.sock}"
if [[ ! -S "$SOCK" ]]; then
  echo "layout sock missing: $SOCK" >&2
  exit 1
fi
cmd="${1:-grab}"
python3 - "$SOCK" "$cmd" "${2:-}" "${3:-}" <<'PY'
import json, os, socket, sys
sock_path, cmd = sys.argv[1], sys.argv[2]
a = sys.argv[3] if len(sys.argv) > 3 else ""
b = sys.argv[4] if len(sys.argv) > 4 else ""
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
def send(obj):
    s.sendall((json.dumps(obj) + "\n").encode())
# Register a transient fake panel so we stay connected long enough; GroupGrab
# itself does not require Hello, but Bye-on-close keeps the daemon tidy.
send({"Hello": {"metrics": {"size_px": [64, 64], "density_px_per_m": 3000.0, "app_id": "cyl-nudge", "title": "nudge"}}})
# Drain Assigned
s.settimeout(1.0)
try:
    _ = s.recv(65536)
except Exception:
    pass
if cmd == "grab":
    dy = float(a or "0.15"); dh = float(b or "0.0")
    send({"GroupGrab": {"delta_yaw": dy, "delta_height": dh}})
elif cmd == "radius":
    send({"SetRadius": {"radius_m": float(a or "0.70")}})
elif cmd == "reanchor":
    send({"Reanchor": {"hmd_yaw": float(a or "0.0"), "hmd_height": float(b or "0.0")}})
else:
    print(f"unknown cmd {cmd}; use grab|radius|reanchor", file=sys.stderr)
    sys.exit(2)
print(f"sent {cmd} -> {sock_path}")
s.close()
PY
