#!/usr/bin/env bash
# Send GroupGrab / SetRadius / Reanchor / Swap / Reorder / Shift to cylinder-layout.
# Visual bead is implemented in cylinder-shell; this is the CLI for the same IPC.
set -euo pipefail
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/cylinder-headset-side"
SOCK="${CYLINDER_LAYOUT_SOCK:-}"
if [[ -z "$SOCK" && -f "$STATE/layout.sock.path" ]]; then
  SOCK=$(cat "$STATE/layout.sock.path")
fi
SOCK="${SOCK:-${XDG_RUNTIME_DIR:-/run/user/$UID}/stardust-cylinder/layout.sock}"
if [[ ! -S "$SOCK" ]]; then
  echo "layout sock missing: $SOCK" >&2
  exit 1
fi
cmd="${1:-grab}"
python3 - "$SOCK" "$cmd" "${2:-}" "${3:-}" <<'PY'
import json, os, socket, sys
sock_path, cmd = sys.argv[1], sys.argv[2]
a = sys.argv[3] if len(sys.argv) > 3 else ""
b = sys.argv[4] if len(sys.argv) > 4 else ""
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
def send(obj):
    s.sendall((json.dumps(obj) + "\n").encode())
send({"Hello": {"metrics": {"size_px": [64, 64], "density_px_per_m": 3000.0, "app_id": "cyl-nudge", "title": "nudge"}}})
s.settimeout(1.0)
assigned = None
try:
    buf = b""
    while b"\n" not in buf:
        buf += s.recv(65536)
    assigned = json.loads(buf.split(b"\n", 1)[0])
except Exception:
    pass
if cmd == "grab":
    dy = float(a or "0.15"); dh = float(b or "0.0")
    send({"GroupGrab": {"delta_yaw": dy, "delta_height": dh}})
elif cmd == "radius":
    send({"SetRadius": {"radius_m": float(a or "0.70")}})
elif cmd == "reanchor":
    send({"Reanchor": {"hmd_yaw": float(a or "0.0"), "hmd_height": float(b or "0.0")}})
elif cmd == "swap":
    send({"Swap": {"a": {"0": int(a)}, "b": {"0": int(b)}}}) if False else send({"Swap": {"a": int(a), "b": int(b)}})
elif cmd == "reorder":
    send({"Reorder": {"id": int(a), "index": int(b or "0")}})
elif cmd == "shift":
    # shift the nudge's own Assigned id, or explicit id
    nid = int(a) if a else (assigned or {}).get("Assigned", {}).get("slot", {}).get("id")
    if nid is None:
        print("shift needs slot id", file=sys.stderr); sys.exit(2)
    send({"Shift": {"id": int(nid), "delta": int(b or "1")}})
else:
    print(f"unknown cmd {cmd}; use grab|radius|reanchor|swap|reorder|shift", file=sys.stderr)
    sys.exit(2)
print(f"sent {cmd} -> {sock_path}")
s.close()
PY
