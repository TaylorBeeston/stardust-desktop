#!/usr/bin/env bash
# Panel shell for stardust-xr-wayland-service:  -p <this file>
# Candidate B worker. `just install-cylinder-shell` (or cyl-headset scripts) write this
# with @PREFIX@ replaced. Does NOT replace Flatland's stardust_panel_shell by itself.
PREFIX="${STARDUST_PREFIX:-@PREFIX@}"
export PATH="$PREFIX/bin:${PATH:-/usr/bin:/bin}"
# Keep bootstrap share so asteroids resources resolve when protostar strips env.
BOOT_SHARE="${STARDUST_BOOTSTRAP_SHARE:-$HOME/dev/open-source/stardust-bootstrap/prefix/usr/share}"
export STARDUST_RES_PREFIXES="$PREFIX/share:${BOOT_SHARE}:${STARDUST_RES_PREFIXES:-/usr/share}"
LOG="${XDG_RUNTIME_DIR:-/tmp}/stardust-cylinder-shell.log"
SHELL_BIN="${CYLINDER_SHELL_BIN:-$PREFIX/bin/cylinder-shell}"
[ -x "$SHELL_BIN" ] || SHELL_BIN="$(command -v cylinder-shell || echo cylinder-shell)"
{
  echo "==== $(date -Is) pid=$$ ===="
  echo "STARDUST_INSTANCE=${STARDUST_INSTANCE-}"
  echo "SDXR_PROTECTED_PANEL=${SDXR_PROTECTED_PANEL-}"
  echo "SDXR_WL_APP_ID=${SDXR_WL_APP_ID-} title=${SDXR_WL_TITLE-}"
  echo "shell=$SHELL_BIN"
} >>"$LOG" 2>&1
# Per-panel Hello metrics. Layout width_m = size_px / density; surface resize does NOT
# currently re-Hello, so host-mirror must match Flatland's WayVR sizes up front:
#   eDP-1  2560px @ 2300 → 1.113 m   Meta-0  3440px @ 2070 → 1.662 m
# Always apply for host-mirror app_ids (ignore inherited CYLINDER_DENSITY=3000 from
# parent env). Set CYLINDER_METRICS_LOCKED=1 to keep an explicit override.
if [ "${CYLINDER_METRICS_LOCKED-}" != 1 ]; then
  case "${SDXR_WL_APP_ID-} ${SDXR_WL_TITLE-}" in
    *host-mirror-edp-1*|*"Host Mirror eDP-1"*)
      export CYLINDER_WIDTH_PX=2560
      export CYLINDER_HEIGHT_PX=1600
      export CYLINDER_DENSITY=2300
      ;;
    *host-mirror-meta-0*|*"Host Mirror Meta-0"*)
      export CYLINDER_WIDTH_PX=3440
      export CYLINDER_HEIGHT_PX=1440
      export CYLINDER_DENSITY=2070
      ;;
  esac
fi
{
  echo "CYLINDER_DENSITY=${CYLINDER_DENSITY-<default 3000>} size=${CYLINDER_WIDTH_PX-?}x${CYLINDER_HEIGHT_PX-?}"
} >>"$LOG" 2>&1
export RUST_LOG="${RUST_LOG:-cylinder_shell=info,warn}"
exec "$SHELL_BIN" "$@" >>"$LOG" 2>&1
